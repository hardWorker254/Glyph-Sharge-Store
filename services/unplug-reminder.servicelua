-- Glyph Sharge service rule
-- format: 1
-- name: Unplug Reminder
-- id: unplug-reminder
-- author: hardWorker254
-- license: MIT
-- description: Plays the rule's animation when the charger is disconnected
-- devices: PHONE1,PHONE2,PHONE2A,PHONE3A
-- created: 1773072000000
-- updated: 1773072000000
-- version: 1

-- A single edge: the moment power goes away. The animation
-- is the rule's own — pick a short one in the constructor
-- so the reminder is a signal, not a performance.

glyph.on("power_disconnected", function()
  glyph.playAnimation()
end)
